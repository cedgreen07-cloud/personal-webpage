# ─── Whoop Developer Credentials ───────────────────────────────────────────────
# 1. Go to https://developer.whoop.com and create an application
# 2. Set the Redirect URI to: {BASE_URL}/auth/whoop/callback
#    (e.g. http://localhost:3000/auth/whoop/callback for local dev,
#     or https://your-app.onrender.com/auth/whoop/callback when deployed)
# 3. Copy your Client ID and Client Secret below
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# Public URL of this server (no trailing slash). Used to build the Whoop redirect URI.
# Local dev can leave this unset — it defaults to http://localhost:PORT
BASE_URL=https://your-app.onrender.com

# Port the server listens on (Render sets this automatically)
PORT=3000

# ─── Upstash Redis (persists Whoop tokens across restarts/redeploys) ──────────
# 1. Go to https://console.upstash.com, create a free Redis database
# 2. Copy the REST URL and REST Token from the database's "REST API" section
# If left unset, tokens are stored in tokens.json locally (fine for local dev,
# but Render's free tier wipes this file on every restart).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ─── FatSecret Developer Credentials ───────────────────────────────────────────
# 1. Go to https://platform.fatsecret.com, sign in, and generate an OAuth 2.0 API key
# 2. Copy your Client ID and Client Secret below
FATSECRET_CLIENT_ID=your_client_id_here
FATSECRET_CLIENT_SECRET=your_client_secret_here
